{
  "name": "neilwjames/email-notice-wp-document-revisions",
  "description": "An add-on plugin to WP Document Revisions that allows notification emails to be sent after document publication",
  "license": "GPLv3",
  "authors": [
    {
      "name": "Neil W James",
      "email": "neil@familyjames.com"
    }
  ],
  "require": {},
  "require-dev": {
    "phpcsstandards/phpcsutils": "^1.2",
    "phpcsstandards/phpcsextra": "^1.5",
    "wp-coding-standards/wpcs": "~3.4.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "yoast/phpunit-polyfills": "*",
    "phpcompatibility/php-compatibility": "*",
    "phpcompatibility/phpcompatibility-paragonie": "*",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpunit/phpunit": "^9.6"
  },
  "config": {
    "bin-dir": "bin",
    "vendor-dir": "vendor",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=phpcs.ruleset.xml -p -s wpdr-email-notice.php uninstall.php includes tests",
    "lint-fix": "phpcbf --standard=phpcs.ruleset.xml wpdr-email-notice.php uninstall.php includes tests"
  }
}
